package Ex05;

import java.util.ArrayList;
import java.util.List;
public class Main {
    public static void main(String[] args) {
        List<Employee> employees = new ArrayList<>();
        employees.add(new Employee("NV01", "An", "IT"));
        employees.add(new Employee("NV02", "Bình", "HR"));
        employees.add(new Employee("NV03", "Cường", "IT"));
        employees.add(new Employee("NV04", "Dung", "SALES"));
        employees.add(new Employee("NV05", "Hoa", "HR"));
        String department = "IT";
        List<String> employeeNames = DepartmentService.getEmployeeNamesByDept(employees, department);
        System.out.println("|          DANH SÁCH NHÂN SỰ PHÒNG IT (STREAM MAP)     |");
        for (int i = 0; i < employeeNames.size(); i++) {
            System.out.printf("| %-2d. %-47s |\n", i + 1, employeeNames.get(i));
        }
        System.out.printf("| -> Tổng cộng: %-2d nhân sự phòng %-18s |\n", employeeNames.size(), department);
    }
}
